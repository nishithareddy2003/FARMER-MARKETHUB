{
  "frontend": {
    "buildCommand": "ng build --configuration production",
    "outputPath": "dist/farmer-market-hub",
    "environmentFile": "src/environments/environment.prod.ts",
    "serverConfig": {
      "port": 4200,
      "host": "0.0.0.0"
    },
    "dependencies": {
      "@angular/cli": "^16.0.0",
      "@angular/compiler-cli": "^16.0.0"
    }
  },
  "backend": {
    "apiUrl": "https://api.farmermarkethub.com/api",
    "cors": {
      "origin": ["https://farmermarkethub.com", "https://www.farmermarkethub.com"],
      "methods": ["GET", "POST", "PUT", "DELETE"],
      "credentials": true
    },
    "database": {
      "type": "postgresql",
      "ssl": true
    },
    "security": {
      "jwtSecret": "${process.env.JWT_SECRET}",
      "jwtExpiresIn": "7d"
    }
  },
  "monitoring": {
    "enabled": true,
    "errorReporting": true,
    "performance": true
  }
}